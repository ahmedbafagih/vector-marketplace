{
  "manifest_version": 3,
  "name": "Marketplace AI",
  "version": "0.2.31",
  "description": "Free, open source Facebook Marketplace automation for sourcing, negotiation, listings, and buyer replies. By Floss and Pixel.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
